# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Where the app reads game data on the server:
#   seed      JSON files in seed/ (local development and CI)
#   supabase  the Supabase project (production)
DATA_SOURCE=seed

# Supabase project: Project Settings > API Keys. Read on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Only for running the updater on your own machine. It bypasses RLS:
# keep it in GitHub Secrets, never in Vercel or any frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the updater and POST /api/revalidate.
REVALIDATE_SECRET=

# Public site URL for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://metapick-mlbb.vercel.app
